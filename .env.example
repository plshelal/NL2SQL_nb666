# ============================================================
# 金融问数系统 环境变量配置
# 复制本文件为 .env,填写真实值(.env 不会被提交到 Git)
# ============================================================

# ---- MySQL 数据库 ----
# Docker 启动的 MySQL 容器的 root 密码(不是你本地已有 MySQL 的密码)
# 你自己定一个,Docker 用这个密码建容器,安装脚本也用这个密码连——读同一个 .env 自动对齐
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123321
DB_NAME=finance
APP_PORT=8000

# ---- DeepSeek LLM ----
# 必填!没有这个系统无法生成 SQL
# 申请地址:https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# ---- Qdrant 向量数据库(Docker 自动启动,默认不用改) ----
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ---- Elasticsearch 全文检索(Docker 自动启动,默认不用改) ----
ES_HOST=127.0.0.1
ES_PORT=9200

# ---- TEI 嵌入服务(Docker 自动启动,默认不用改) ----
# 预装模型 bge-large-zh-v1.5,1024 维向量
TEI_HOST=127.0.0.1
TEI_PORT=8081

# ---- iFinD 外部数据(同花顺 EDB 宏观库 + 资讯) ----
# 可选:不填则外部数据功能关闭,不影响行内指标查询
# token 向同花顺申请
IFIND_MCP_TOKEN=your-ifind-mcp-token
# 外部数据开关:1=启用,0=关闭(未填 token 时建议设 0)
EXTERNAL_ENABLED=0
